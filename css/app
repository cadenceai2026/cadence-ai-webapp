/* ── APP LAYOUT ── */
.app-layout {
  display: flex;
  min-height: 100vh;
}

/* Sidebar desktop */
.sidebar {
  width: 240px;
  min-height: 100vh;
  background: var(--surface);
  border-right: 1px solid var(--border);
  display: flex;
  flex-direction: column;
  padding: 24px 16px;
  position: fixed;
  top: 0; left: 0; bottom: 0;
  z-index: 50;
  flex-shrink: 0;
}
.sidebar-logo {
  display: flex;
  align-items: center;
  gap: 8px;
  padding: 0 8px;
  margin-bottom: 32px;
  text-decoration: none;
}
.sidebar-wordmark {
  font-family: 'Syne', sans-serif;
  font-weight: 800;
  font-size: 1.1rem;
  letter-spacing: -0.02em;
  color: var(--text);
}
.sidebar-wordmark span { color: var(--green); }
.sidebar-nav { flex: 1; display: flex; flex-direction: column; gap: 2px; }
.nav-item {
  display: flex;
  align-items: center;
  gap: 10px;
  padding: 10px 12px;
  border-radius: 8px;
  cursor: pointer;
  transition: all 0.15s;
  color: var(--muted);
  font-size: 0.88rem;
  border: 1px solid transparent;
  background: none;
  width: 100%;
  text-align: left;
  font-family: 'Space Grotesk', sans-serif;
  text-decoration: none;
}
.nav-item:hover { background: var(--surface2); color: var(--text); text-decoration: none; }
.nav-item.active { background: var(--green-dim); color: var(--green); border-color: #00E5A018; }
.nav-icon { font-size: 1rem; width: 20px; text-align: center; flex-shrink: 0; }

.sidebar-bottom { padding-top: 16px; border-top: 1px solid var(--border); }
.plan-pill { border-radius: 10px; padding: 12px; margin-bottom: 12px; border: 1px solid var(--border2); background: var(--surface2); }
.plan-pill.trial { background: var(--green-dim); border-color: #00E5A022; }
.plan-pill.elite { background: linear-gradient(135deg,#00E5A015,var(--surface2)); border-color: var(--green); }
.plan-pill-label { font-size: 0.68rem; color: var(--green); font-family: 'DM Mono', monospace; margin-bottom: 3px; letter-spacing: 0.08em; }
.plan-pill-name { font-family: 'Syne', sans-serif; font-weight: 800; font-size: 1.05rem; letter-spacing: -0.02em; }
.plan-pill-sub { font-size: 0.68rem; color: var(--muted); margin-top: 2px; }
.upgrade-btn { width: 100%; background: var(--green); color: #080808; border: none; border-radius: 8px; padding: 8px; font-family: 'Space Grotesk', sans-serif; font-weight: 600; font-size: 0.78rem; cursor: pointer; margin-top: 8px; transition: background 0.2s; }
.upgrade-btn:hover { background: #00ffb3; }
.user-row { display: flex; align-items: center; gap: 10px; padding: 8px 4px; }
.user-av { width: 32px; height: 32px; border-radius: 50%; background: var(--green-dim); border: 1px solid #00E5A025; display: flex; align-items: center; justify-content: center; font-size: 0.75rem; font-weight: 600; color: var(--green); flex-shrink: 0; overflow: hidden; }
.user-av img { width: 100%; height: 100%; object-fit: cover; border-radius: 50%; }
.user-name { font-size: 0.82rem; font-weight: 500; flex: 1; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.user-plan-badge { font-size: 0.62rem; color: var(--green); font-family: 'DM Mono', monospace; }

/* ── MAIN CONTENT ── */
.app-main {
  margin-left: 240px;
  flex: 1;
  min-height: 100vh;
  display: flex;
  flex-direction: column;
}
.topbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 18px 32px;
  border-bottom: 1px solid var(--border);
  background: var(--bg);
  position: sticky;
  top: 0;
  z-index: 40;
}
.topbar-title { font-family: 'Syne', sans-serif; font-weight: 800; font-size: 1.2rem; letter-spacing: -0.02em; }
.topbar-actions { display: flex; gap: 8px; align-items: center; }

/* ── PAGE ── */
.page { display: none; padding: 28px 32px; flex: 1; animation: fadeUp 0.3s ease both; }
.page.active { display: block; }

/* ── MOBILE TOPBAR ── */
.mob-topbar {
  display: none;
  position: sticky;
  top: 0;
  z-index: 40;
  background: var(--bg);
  border-bottom: 1px solid var(--border);
  padding: 12px 16px;
  align-items: center;
  justify-content: space-between;
}
.mob-logo { font-family: 'Syne', sans-serif; font-weight: 800; font-size: 1.05rem; letter-spacing: -0.02em; }
.mob-logo span { color: var(--green); }
.mob-right { display: flex; align-items: center; gap: 8px; }
.mob-plan { font-size: 0.62rem; font-family: 'DM Mono', monospace; padding: 3px 8px; border-radius: 100px; background: var(--green-dim); color: var(--green); border: 1px solid #00E5A025; cursor: pointer; }
.mob-av { width: 30px; height: 30px; border-radius: 50%; background: var(--green-dim); border: 1px solid #00E5A025; display: flex; align-items: center; justify-content: center; font-size: 0.72rem; font-weight: 600; color: var(--green); overflow: hidden; cursor: pointer; }
.mob-av img { width: 100%; height: 100%; object-fit: cover; border-radius: 50%; }

/* ── MOBILE BOTTOM NAV ── */
.mob-nav {
  display: none;
  position: fixed;
  bottom: 0; left: 0; right: 0;
  background: var(--surface);
  border-top: 1px solid var(--border);
  padding: 8px 0 max(8px, env(safe-area-inset-bottom));
  z-index: 50;
}
.mob-nav-items { display: flex; justify-content: space-around; align-items: center; }
.mob-nav-btn {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 3px;
  background: none;
  border: none;
  cursor: pointer;
  color: var(--muted);
  transition: color 0.2s;
  padding: 6px 14px;
  flex: 1;
  font-family: 'Space Grotesk', sans-serif;
}
.mob-nav-btn.active { color: var(--green); }
.mob-nav-icon { font-size: 1.25rem; }
.mob-nav-label { font-size: 0.58rem; font-family: 'DM Mono', monospace; letter-spacing: 0.05em; text-transform: uppercase; }

/* ── DASHBOARD ── */
.welcome-hero {
  background: linear-gradient(135deg, #00E5A010, var(--surface));
  border: 1px solid #00E5A020;
  border-radius: 16px;
  padding: 28px;
  margin-bottom: 20px;
  position: relative;
  overflow: hidden;
}
.welcome-hero::after {
  content: '';
  position: absolute;
  top: -30px; right: -30px;
  width: 140px; height: 140px;
  background: radial-gradient(circle, #00E5A022, transparent 70%);
  border-radius: 50%;
}
.welcome-name { font-family: 'Syne', sans-serif; font-weight: 800; font-size: 1.6rem; letter-spacing: -0.02em; margin-bottom: 4px; }
.welcome-sub { font-size: 0.85rem; color: var(--muted); margin-bottom: 14px; }
.welcome-plan { display: inline-block; background: var(--green-dim); color: var(--green); border: 1px solid #00E5A025; border-radius: 100px; padding: 4px 14px; font-size: 0.7rem; font-family: 'DM Mono', monospace; }

/* Stats */
.stats-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(150px, 1fr)); gap: 12px; margin-bottom: 24px; }
.stat-card { background: var(--surface); border: 1px solid var(--border); border-radius: 12px; padding: 18px; }
.stat-label { font-size: 0.65rem; color: var(--muted); text-transform: uppercase; letter-spacing: 0.1em; font-family: 'DM Mono', monospace; margin-bottom: 6px; }
.stat-value { font-family: 'DM Mono', monospace; font-size: 1.7rem; font-weight: 500; line-height: 1; }
.stat-value.g { color: var(--green); }
.stat-sub { font-size: 0.68rem; color: var(--muted); margin-top: 3px; }

/* Quick actions */
.quick-actions { display: grid; grid-template-columns: repeat(auto-fit, minmax(140px, 1fr)); gap: 10px; margin-bottom: 24px; }
.quick-action {
  background: var(--surface);
  border: 1px solid var(--border);
  border-radius: 12px;
  padding: 16px;
  cursor: pointer;
  transition: all 0.2s;
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  gap: 8px;
  font-family: 'Space Grotesk', sans-serif;
  text-align: left;
}
.quick-action:hover { border-color: var(--green); transform: translateY(-1px); }
.qa-icon { font-size: 1.4rem; }
.qa-label { font-size: 0.82rem; font-weight: 600; }
.qa-desc { font-size: 0.72rem; color: var(--muted); }

/* Section header */
.sec-head { display: flex; align-items: center; justify-content: space-between; margin-bottom: 14px; }
.sec-title { font-family: 'DM Mono', monospace; font-size: 0.7rem; color: var(--muted); text-transform: uppercase; letter-spacing: 0.1em; }

/* ── ACTIVITY CARDS ── */
.acts-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(300px, 1fr)); gap: 12px; }
.act-card { background: var(--surface); border: 1px solid var(--border); border-radius: 12px; padding: 18px; transition: border-color 0.2s, transform 0.15s; }
.act-card:hover { border-color: var(--border2); transform: translateY(-1px); }
.act-top { display: flex; align-items: flex-start; justify-content: space-between; margin-bottom: 12px; }
.act-icon { width: 34px; height: 34px; border-radius: 8px; display: flex; align-items: center; justify-content: center; font-size: 1rem; background: var(--green-dim); flex-shrink: 0; }
.act-name { font-weight: 600; font-size: 0.95rem; margin-bottom: 2px; }
.act-meta { font-size: 0.7rem; color: var(--muted); }
.act-stats { display: grid; grid-template-columns: repeat(3, 1fr); gap: 8px; padding-top: 12px; border-top: 1px solid var(--border); }
.act-stat { text-align: center; }
.act-stat-val { font-family: 'DM Mono', monospace; font-size: 0.95rem; font-weight: 500; display: block; }
.act-stat-lbl { font-size: 0.6rem; color: var(--muted); text-transform: uppercase; letter-spacing: 0.08em; }

/* ── COACH ── */
.coach-selector { text-align: center; padding: 40px 20px; }
.coach-selector-title { font-family: 'Syne', sans-serif; font-weight: 800; font-size: 1.5rem; letter-spacing: -0.02em; margin-bottom: 6px; }
.coach-selector-sub { font-size: 0.85rem; color: var(--muted); margin-bottom: 32px; }
.coach-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 12px; max-width: 500px; margin: 0 auto; }
.coach-card { background: var(--surface); border: 1px solid var(--border); border-radius: 14px; padding: 22px; text-align: center; cursor: pointer; transition: all 0.2s; position: relative; }
.coach-card:hover { transform: translateY(-2px); border-color: var(--border2); }
.coach-card.selected { border-color: var(--green); background: var(--green-dim); }
.coach-card.soon { opacity: 0.55; cursor: not-allowed; }
.coach-card.soon:hover { transform: none; border-color: var(--border); }
.soon-tag { position: absolute; top: -8px; right: 8px; background: var(--surface3); color: var(--muted); font-size: 0.58rem; font-family: 'DM Mono', monospace; padding: 2px 8px; border-radius: 100px; border: 1px solid var(--border2); }
.coach-icon { font-size: 1.8rem; margin-bottom: 8px; }
.coach-name { font-family: 'Syne', sans-serif; font-weight: 700; font-size: 0.92rem; margin-bottom: 3px; }
.coach-desc { font-size: 0.7rem; color: var(--muted); }
.coach-badge { display: inline-block; margin-top: 6px; background: var(--green-dim); color: var(--green); border: 1px solid #00E5A025; border-radius: 100px; padding: 2px 10px; font-size: 0.62rem; font-family: 'DM Mono', monospace; }

/* Chat */
.chat-wrap { background: var(--surface); border: 1px solid var(--border); border-radius: 14px; display: flex; flex-direction: column; overflow: hidden; height: calc(100vh - 160px); }
.chat-head { padding: 14px 18px; border-bottom: 1px solid var(--border); display: flex; align-items: center; gap: 10px; }
.chat-dot { width: 7px; height: 7px; background: var(--green); border-radius: 50%; animation: blink 2s ease-in-out infinite; flex-shrink: 0; }
.chat-head-name { font-weight: 600; font-size: 0.9rem; }
.chat-head-model { font-size: 0.7rem; color: var(--muted); font-family: 'DM Mono', monospace; margin-left: auto; }
.chat-msgs { flex: 1; overflow-y: auto; padding: 18px; display: flex; flex-direction: column; gap: 14px; scroll-behavior: smooth; }
.chat-msgs::-webkit-scrollbar { width: 4px; }
.chat-msgs::-webkit-scrollbar-thumb { background: var(--border2); border-radius: 2px; }
.msg { display: flex; gap: 9px; align-items: flex-start; animation: fadeUp 0.3s ease both; }
.msg.user { flex-direction: row-reverse; }
.msg-av { width: 28px; height: 28px; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 0.7rem; font-weight: 600; flex-shrink: 0; }
.msg-av.ai { background: var(--green-dim); color: var(--green); border: 1px solid #00E5A025; }
.msg-av.me { background: var(--surface3); color: var(--muted); border: 1px solid var(--border2); overflow: hidden; }
.msg-av.me img { width: 100%; height: 100%; object-fit: cover; border-radius: 50%; }
.msg-bubble { background: var(--surface2); border: 1px solid var(--border); border-radius: 10px; padding: 11px 14px; font-size: 0.87rem; line-height: 1.6; max-width: 80%; }
.msg.user .msg-bubble { background: var(--green-dim); border-color: #00E5A020; }
.msg-time { font-size: 0.62rem; color: var(--muted2); font-family: 'DM Mono', monospace; margin-top: 4px; }
.chat-inp-wrap { padding: 14px 18px; border-top: 1px solid var(--border); display: flex; gap: 8px; }
.chat-inp { flex: 1; background: var(--surface2); border: 1px solid var(--border2); border-radius: 10px; padding: 10px 14px; color: var(--text); font-family: 'Space Grotesk', sans-serif; font-size: 0.87rem; outline: none; resize: none; transition: border-color 0.2s; min-height: 42px; max-height: 100px; }
.chat-inp:focus { border-color: var(--green); }
.chat-inp::placeholder { color: var(--muted2); }
.chat-send { background: var(--green); color: #080808; border: none; border-radius: 10px; width: 42px; height: 42px; display: flex; align-items: center; justify-content: center; cursor: pointer; flex-shrink: 0; font-size: 1rem; transition: background 0.2s; }
.chat-send:hover { background: #00ffb3; }
.chat-send:disabled { opacity: 0.4; cursor: not-allowed; }
.quick-prompts { display: flex; gap: 8px; overflow-x: auto; padding: 10px 18px 0; }
.quick-prompts::-webkit-scrollbar { height: 0; }
.qp { background: var(--surface2); border: 1px solid var(--border2); border-radius: 20px; padding: 6px 14px; font-size: 0.76rem; color: var(--muted); cursor: pointer; white-space: nowrap; font-family: 'Space Grotesk', sans-serif; transition: all 0.15s; flex-shrink: 0; }
.qp:hover { border-color: var(--green); color: var(--green); }
.typing { display: flex; gap: 4px; align-items: center; padding: 2px 0; }
.typing-dot { width: 6px; height: 6px; background: var(--green); border-radius: 50%; animation: typing 1.2s ease-in-out infinite; }
.typing-dot:nth-child(2) { animation-delay: 0.2s; }
.typing-dot:nth-child(3) { animation-delay: 0.4s; }

/* ── GROUPS ── */
.groups-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: 12px; }
.group-card { background: var(--surface); border: 1px solid var(--border); border-radius: 12px; padding: 20px; transition: border-color 0.2s; }
.group-card:hover { border-color: var(--border2); }
.group-bar-bg { height: 3px; background: var(--surface3); border-radius: 2px; margin: 10px 0; }
.group-bar-fg { height: 100%; background: var(--green); border-radius: 2px; }
.btn-join { padding: 8px 16px; border-radius: 8px; font-family: 'Space Grotesk', sans-serif; font-size: 0.82rem; font-weight: 600; cursor: pointer; border: none; transition: all 0.2s; }
.btn-join.joined { background: var(--green-dim); color: var(--green); border: 1px solid #00E5A022; }
.btn-join.open { background: var(--surface2); color: var(--muted); border: 1px solid var(--border2); }
.btn-join.open:hover { border-color: var(--green); color: var(--green); }

/* ── RANKING ── */
.ranking-wrap { background: var(--surface); border: 1px solid var(--border); border-radius: 12px; overflow: hidden; }
.ranking-head { padding: 16px 20px; border-bottom: 1px solid var(--border); display: flex; align-items: center; justify-content: space-between; }
.ranking-row { display: flex; align-items: center; gap: 12px; padding: 12px 20px; border-bottom: 1px solid var(--border); transition: background 0.15s; }
.ranking-row:last-child { border-bottom: none; }
.ranking-row:hover { background: var(--surface2); }
.ranking-row.top1 { background: linear-gradient(90deg,#00E5A008,transparent); }
.rank-pos { font-family: 'DM Mono', monospace; font-size: 0.85rem; color: var(--muted); width: 22px; flex-shrink: 0; }
.rank-pos.gold { color: #FFD700; }
.rank-av { width: 32px; height: 32px; border-radius: 50%; background: var(--surface3); display: flex; align-items: center; justify-content: center; font-size: 0.75rem; font-weight: 600; flex-shrink: 0; }
.rank-name { flex: 1; font-size: 0.88rem; font-weight: 500; }
.rank-km { font-family: 'DM Mono', monospace; font-size: 0.9rem; color: var(--green); }

/* ── SETTINGS ── */
.settings-section { background: var(--surface); border: 1px solid var(--border); border-radius: 12px; padding: 20px; margin-bottom: 12px; }
.settings-title { font-family: 'DM Mono', monospace; font-size: 0.68rem; color: var(--muted); text-transform: uppercase; letter-spacing: 0.12em; margin-bottom: 16px; }
.settings-lbl { font-size: 0.68rem; color: var(--muted); font-family: 'DM Mono', monospace; letter-spacing: 0.08em; text-transform: uppercase; margin-bottom: 8px; }
.chip-row { display: flex; gap: 7px; flex-wrap: wrap; margin-bottom: 14px; }
.chip { background: var(--surface2); border: 1px solid var(--border2); color: var(--muted); border-radius: 8px; padding: 5px 12px; font-family: 'Space Grotesk', sans-serif; font-size: 0.76rem; cursor: pointer; transition: all 0.15s; }
.chip:hover { border-color: var(--green); color: var(--green); }
.chip.on { background: var(--green-dim); border-color: var(--green); color: var(--green); }
.settings-row { display: flex; align-items: center; justify-content: space-between; padding: 12px 0; border-bottom: 1px solid var(--border); gap: 14px; }
.settings-row:last-of-type { border-bottom: none; }
.settings-conn-row { display: flex; align-items: center; justify-content: space-between; padding: 12px 0; border-bottom: 1px solid var(--border); }
.settings-conn-row:last-of-type { border-bottom: none; }
.toggle { position: relative; display: inline-block; width: 42px; height: 22px; flex-shrink: 0; }
.toggle input { opacity: 0; width: 0; height: 0; }
.toggle-track { position: absolute; cursor: pointer; inset: 0; background: var(--surface3); border-radius: 22px; transition: 0.3s; border: 1px solid var(--border2); }
.toggle-track::before { content: ''; position: absolute; width: 16px; height: 16px; left: 2px; bottom: 2px; background: var(--muted); border-radius: 50%; transition: 0.3s; }
.toggle input:checked + .toggle-track { background: var(--green-dim); border-color: var(--green); }
.toggle input:checked + .toggle-track::before { transform: translateX(20px); background: var(--green); }
.settings-save { width: 100%; background: var(--green); color: #080808; border: none; border-radius: 8px; padding: 10px; font-family: 'Space Grotesk', sans-serif; font-weight: 600; font-size: 0.85rem; cursor: pointer; transition: background 0.2s; margin-top: 14px; }
.settings-save:hover { background: #00ffb3; }

/* ── PRICING ── */
.pricing-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 14px; max-width: 700px; }
.pricing-card { background: var(--surface); border: 1px solid var(--border); border-radius: 18px; padding: 28px; position: relative; transition: transform 0.2s; }
.pricing-card:hover { transform: translateY(-2px); }
.pricing-card.featured { border-color: var(--green); background: linear-gradient(135deg,#00E5A008,var(--surface)); }
.pricing-badge { position: absolute; top: -10px; left: 20px; background: var(--green); color: #080808; font-size: 0.7rem; font-weight: 600; padding: 3px 12px; border-radius: 100px; font-family: 'DM Mono', monospace; }
.pricing-name { font-family: 'DM Mono', monospace; font-size: 0.7rem; color: var(--muted); text-transform: uppercase; letter-spacing: 0.12em; margin-bottom: 10px; }
.pricing-price { font-family: 'Syne', sans-serif; font-weight: 800; font-size: 2.6rem; letter-spacing: -0.03em; line-height: 1; margin-bottom: 4px; }
.pricing-price span { font-size: 0.92rem; font-weight: 400; color: var(--muted); font-family: 'Space Grotesk', sans-serif; }
.pricing-desc { font-size: 0.82rem; color: var(--muted); margin-bottom: 20px; }
.pricing-feat { list-style: none; display: flex; flex-direction: column; gap: 7px; margin-bottom: 20px; }
.pricing-feat li { display: flex; gap: 8px; font-size: 0.83rem; color: var(--muted); }
.pricing-feat li.on { color: var(--text); }
.check { color: var(--green); flex-shrink: 0; }

/* ── ADMIN TABLE ── */
.admin-table { width: 100%; border-collapse: collapse; }
.admin-table th { font-size: 0.68rem; color: var(--muted); font-family: 'DM Mono', monospace; text-transform: uppercase; letter-spacing: 0.1em; padding: 10px 16px; text-align: left; border-bottom: 1px solid var(--border); }
.admin-table td { padding: 12px 16px; font-size: 0.85rem; border-bottom: 1px solid var(--border); vertical-align: middle; }
.admin-table tr:hover td { background: var(--surface2); }

/* ── RESPONSIVE ── */
@media (max-width: 768px) {
  .sidebar { display: none; }
  .app-main { margin-left: 0; }
  .mob-topbar { display: flex; }
  .mob-nav { display: block; }
  .topbar { display: none; }
  .page { padding: 16px 16px calc(80px + 16px); }
  .acts-grid { grid-template-columns: 1fr; }
  .groups-grid { grid-template-columns: 1fr; }
  .pricing-grid { grid-template-columns: 1fr; }
  .stats-grid { grid-template-columns: repeat(2, 1fr); }
  .quick-actions { grid-template-columns: repeat(2, 1fr); }
  .coach-grid { grid-template-columns: 1fr 1fr; }
  .chat-wrap { height: calc(100vh - 200px); }
}

@media (min-width: 1200px) {
  .acts-grid { grid-template-columns: repeat(3, 1fr); }
}
